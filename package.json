{
  "name": "sharebox-qa-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "sharebox-qa-editor": "server.js"
  },
  "files": [
    "server.js",
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "server": "node --watch server.js",
    "start": "node server.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "npm pack && mv sharebox-qa-editor-$npm_package_version.tgz sharebox-qa-editor.tgz && gh release create v$npm_package_version sharebox-qa-editor.tgz --generate-notes && rm sharebox-qa-editor.tgz"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
